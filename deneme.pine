//@version=6
indicator("Volcanic Auto Peaks & Valleys v6", overlay=true, max_bars_back=2000, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- GRUPLAR / GROUPS ---
string GRP_AUTO = "⚓ Otomatik Çapa Ayarları / Auto Anchor Settings"
string GRP_FILT = "📏 Filtre Ayarları / Filter Settings"
string GRP_VIS  = "🎨 Görsel Ayarlar / Visual Settings"
string GRP_TAB  = "📊 Tablo Ayarları / Table Settings"

// --- GİRDİLER / INPUTS ---
lb_mode        = input.string("Manuel", "Tarama Modu / Lookback Mode", options=["Manuel", "Otomatik (Hassasiyet)", "Global (Maksimum)", "Manuel (Tarih Seçimi)"], group=GRP_AUTO)
lb_sens        = input.int(1, "Otomatik Hassasiyet / Auto Sensitivity", minval=1, maxval=9, group=GRP_AUTO)
auto_lookback  = input.int(81, "Manuel Tarama Mesafesi / Manual Lookback", minval=10, maxval=1990, group=GRP_AUTO)
auto_threshold = input.float(0.1, "Sabitleme Eşiği / Settle Threshold (x sz)", group=GRP_AUTO)
p_time         = input.time(timestamp("2024-01-01"), "Tepe Çapa Zamanı / Peak Anchor Time", group=GRP_AUTO, confirm=true)
v_time         = input.time(timestamp("2024-01-01"), "Dip Çapa Zamanı / Valley Anchor Time", group=GRP_AUTO, confirm=true)

p_gamma_val    = input.float(9.42477796076938, "Tepe Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793], group=GRP_FILT)
v_gamma_val    = input.float(9.42477796076938, "Dip Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793], group=GRP_FILT)
atr_mult       = input.float(3.1415926535897932, "ATR Periyot Çarpanı", options=[0.0000031415926535897932, 0.000031415926535897932, 0.00031415926535897932, 0.0031415926535897932, 0.031415926535897932, 0.31415926535897932, 3.1415926535897932, 31.415926535897932, 314.15926535897932, 3141.5926535897932], group=GRP_FILT)

auto_atr       = input.bool(true, "Otomatik ATR Periyodu", group=GRP_VIS)
atr_opt        = input.float(8.1, "Manuel ATR Periyodu", minval=0.01, maxval=1990.0, step=0.1, group=GRP_VIS)
use_ha         = input.bool(false, "Heikin Ashi Kullan", group=GRP_VIS)
filt_width     = input.int(2, "Çizgi Kalınlığı", minval=1, maxval=5, group=GRP_VIS)

show_table     = input.bool(true, "Bilgi Tablosunu Göster", group=GRP_TAB)
table_pos      = input.string("Top Right", "Tablo Konumu", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=GRP_TAB)

// --- FONKSİYONLAR ---
f_kama_atr(float src, float n) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.floor(n_eff))
    float frac = n_eff - n_i
    float v_diff = math.abs(src - nz(src[1], src))
    float vol_sum = ta.sma(v_diff, math.max(1, n_i)) * math.max(1, n_i)
    float vol = vol_sum + (frac > 0 ? math.abs(nz(src[n_i], src) - nz(src[n_i+1], src)) * frac : 0)
    float val_n = n_i == 0 ? src : (frac == 0 ? nz(src[n_i], src) : nz(src[n_i], src) * (1.0 - frac) + nz(src[n_i+1], src) * frac)
    float dir = math.abs(src - val_n)
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    n < 1.0 ? kama * n : kama

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

// --- HESAPLAMA ---
var float haOpen = na
haClose = (open + high + low + close) / 4
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

eff_h  = use_ha ? haHigh : high
eff_l  = use_ha ? haLow  : low
float tr = use_ha ? math.max(haHigh - haLow, math.max(math.abs(haHigh - haClose[1]), math.abs(haLow - haClose[1]))) : ta.tr(true)

int lb_input_val = lb_mode == "Global (Maksimum)" ? 1990 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 144 : auto_lookback
bool is_in_range = (lb_mode == "Global (Maksimum)") or (lb_mode == "Manuel (Tarih Seçimi)") or (timenow - time < (lb_input_val + 500) * timeframe.in_seconds() * 1000)

float atr_per = math.min(1990.0, auto_atr ? (timeframe.in_seconds() / 60.0) * atr_mult : atr_opt)
float cur_sz_unit_raw = f_kama_atr(tr, nz(atr_per, 8.1))
float cur_sz_unit = is_in_range ? cur_sz_unit_raw : 0.0

max_bars_back(cur_sz_unit, 2000)
max_bars_back(high, 2000)
max_bars_back(low, 2000)
max_bars_back(eff_h, 2000)
max_bars_back(eff_l, 2000)

// Anchor logic
f_dyn_hb(src, len) => ta.highestbars(src, math.min(len, bar_index + 1))
f_dyn_lb(src, len) => ta.lowestbars(src, math.min(len, bar_index + 1))

hb_4990 = f_dyn_hb(eff_h, 1990), lb_4990 = f_dyn_lb(eff_l, 1990)
hb_auto = f_dyn_hb(eff_h, lb_input_val), lb_auto = f_dyn_lb(eff_l, lb_input_val)

var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p = na
var float last_f_v = na

f_get_settled_idx(bool is_peak, int lb_mode_idx, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, int hb_49, int lb_49, int hb_a, int lb_a) =>
    int off = lb_mode_idx == 0 ? (is_peak ? hb_49 : lb_49) : (is_peak ? hb_a : lb_a)
    int raw_ext_idx = bar_index + off
    int res_idx = prev_settled
    if na(prev_settled) or (bar_index - prev_settled > lb_val)
        res_idx := raw_ext_idx
    else
        bool threshold_reset = not na(prev_f) and not na(sz_val) and math.abs(close - prev_f) > auto_threshold * sz_val
        if threshold_reset
            res_idx := raw_ext_idx
    res_idx

int lb_m_idx = lb_mode == "Global (Maksimum)" ? 0 : 1
if is_in_range
    settled_p_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(true, lb_m_idx, lb_input_val, last_f_p, cur_sz_unit * p_gamma_val, settled_p_idx, eff_h, eff_l, hb_4990, lb_4990, hb_auto, lb_auto)
    settled_v_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(false, lb_m_idx, lb_input_val, last_f_v, cur_sz_unit * v_gamma_val, settled_v_idx, eff_h, eff_l, hb_4990, lb_4990, hb_auto, lb_auto)

if lb_mode == "Manuel (Tarih Seçimi)"
    settled_p_idx := ta.valuewhen(time <= p_time, bar_index, 0)
    settled_v_idx := ta.valuewhen(time <= v_time, bar_index, 0)

var FiltState fs_p = FiltState.new()
var FiltState fs_v = FiltState.new()
is_p_anc = (bar_index == settled_p_idx) or (ta.change(settled_p_idx) != 0)
is_v_anc = (bar_index == settled_v_idx) or (ta.change(settled_v_idx) != 0)
float init_p_val = eff_h[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
float init_v_val = eff_l[math.max(0, bar_index - nz(settled_v_idx, bar_index))]

last_f_p := fs_p.upd_filt(eff_h, eff_l, cur_sz_unit * p_gamma_val, init_p_val, is_p_anc)
last_f_v := fs_v.upd_filt(eff_h, eff_l, cur_sz_unit * v_gamma_val, init_v_val, is_v_anc)

// Drawing
var polyline p_pl = na, var polyline v_pl = na
if barstate.islast
    polyline.delete(p_pl), polyline.delete(v_pl)
    if not na(settled_p_idx)
        chart.point[] pts = array.new<chart.point>(0)
        FiltState f = FiltState.new()
        int s = math.max(bar_index - 1990, settled_p_idx)
        float st = eff_h[bar_index-s]
        for j = s to bar_index
            float cf = f.upd_filt(eff_h[bar_index-j], eff_l[bar_index-j], cur_sz_unit[bar_index-j] * p_gamma_val, st, j == s)
            array.push(pts, chart.point.from_index(j, cf))
        p_pl := polyline.new(pts, line_color=color.yellow, line_width=filt_width)
    if not na(settled_v_idx)
        chart.point[] pts = array.new<chart.point>(0)
        FiltState f = FiltState.new()
        int s = math.max(bar_index - 1990, settled_v_idx)
        float st = eff_l[bar_index-s]
        for j = s to bar_index
            float cf = f.upd_filt(eff_h[bar_index-j], eff_l[bar_index-j], cur_sz_unit[bar_index-j] * v_gamma_val, st, j == s)
            array.push(pts, chart.point.from_index(j, cf))
        v_pl := polyline.new(pts, line_color=color.yellow, line_width=filt_width)

// Table
if show_table and barstate.islast
    pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : position.bottom_left
    var table info = table.new(pos, 2, 4, border_width=1)
    table.cell(info, 0, 0, "💎 Volcanic", bgcolor=color.black, text_color=color.yellow)
    table.cell(info, 1, 0, "Değer", bgcolor=color.black, text_color=color.white)
    table.cell(info, 0, 1, "Tepe Gamma", bgcolor=color.gray)
    table.cell(info, 1, 1, str.tostring(p_gamma_val), bgcolor=color.gray)
    table.cell(info, 0, 2, "Dip Gamma", bgcolor=color.gray)
    table.cell(info, 1, 2, str.tostring(v_gamma_val), bgcolor=color.gray)
    table.cell(info, 0, 3, "ATR Per.", bgcolor=color.gray)
    table.cell(info, 1, 3, str.tostring(atr_per), bgcolor=color.gray)

// Anchor Labels
var label lp = na, var label lv = na
if barstate.islast
    if not na(settled_p_idx)
        int h_off = math.max(0, math.min(1999, bar_index - settled_p_idx))
        if na(lp)
            lp := label.new(settled_p_idx, eff_h[h_off], "⚓ Tepe", color=color.red, textcolor=color.white, style=label.style_label_down)
        else
            label.set_xy(lp, settled_p_idx, eff_h[h_off])
    if not na(settled_v_idx)
        int v_off = math.max(0, math.min(1999, bar_index - settled_v_idx))
        if na(lv)
            lv := label.new(settled_v_idx, eff_l[v_off], "⚓ Dip", color=color.green, textcolor=color.white, style=label.style_label_up)
        else
            label.set_xy(lv, settled_v_idx, eff_l[v_off])
