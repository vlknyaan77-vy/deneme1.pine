//@version=6
indicator("Volcanic Auto Peaks & Valleys v6", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- GRUPLAR / GROUPS ---
string GRP_AUTO   = "⚓ Otomatik Çapa Ayarları / Auto Anchor Settings"
string GRP_FILT_P = "📏 Tepe Filtre Ayarları / Peak Filter Settings"
string GRP_FILT_V = "📏 Dip Filtre Ayarları / Valley Filter Settings"
string GRP_VIS    = "🎨 Görsel Ayarlar / Visual Settings"
string GRP_TAB    = "📊 Tablo Ayarları / Table Settings"

// --- GİRDİLER / INPUTS ---
lb_mode        = input.string("Manuel", "Tarama Modu / Lookback Mode", options=["Manuel", "Otomatik (Hassasiyet)", "Global (Maksimum)", "Manuel (Tarih Seçimi)"], group=GRP_AUTO)
lb_sens        = input.int(1, "Otomatik Hassasiyet / Auto Sensitivity", minval=1, maxval=9, group=GRP_AUTO)
auto_lookback  = input.int(81, "Manuel Tarama Mesafesi / Manual Lookback", minval=10, maxval=4713, group=GRP_AUTO)
auto_threshold = input.float(0.1, "Sabitleme Eşiği / Settle Threshold (x sz)", group=GRP_AUTO)
auto_prox_threshold = input.float(0.5, "Yaklaşma Eşiği / Proximity Threshold (%)", group=GRP_AUTO)
p_time         = input.time(timestamp("2030-01-01"), "Tepe Çapa Zamanı / Peak Anchor Time", group=GRP_AUTO, confirm=true)
v_time         = input.time(timestamp("2030-01-01"), "Dip Çapa Zamanı / Valley Anchor Time", group=GRP_AUTO, confirm=true)

// --- GAMMA GİRDİLERİ ---
p_gamma_opt    = input.string("0.785", "Tepe Gamma Seçimi (PI)", options=["0.785", "1.571", "2.356", "3.142", "3.927", "4.712", "5.498", "6.283", "7.069", "7.854", "8.639", "9.425", "10.210", "10.996", "11.781", "12.566", "13.352", "14.137", "14.923", "15.708", "16.493", "17.279", "18.064", "18.849", "19.635", "20.420", "21.206", "21.991", "22.777", "23.562", "24.347", "25.133", "25.918", "26.704", "27.489", "28.274", "29.060", "29.845", "30.631", "31.416"], group=GRP_FILT_P)
p_mult_mode    = input.string("Çarpan 1", "Tepe ATR Çarpan Seçimi", options=["Çarpan 1", "Çarpan 2"], group=GRP_FILT_P)
p_mult_1       = input.float(3.69, "Tepe ATR Periyot Çarpanı 1", options=[0.00369, 0.0369, 0.369, 3.69, 36.9, 369, 3693], group=GRP_FILT_P)
p_mult_2       = input.string("3.141593", "Tepe ATR Periyot Çarpanı 2", options=["0.000003", "0.000031", "0.000314", "0.003142", "0.031416", "0.314159", "3.141593", "31.415927", "314.159265", "3141.592654"], group=GRP_FILT_P)

v_gamma_opt    = input.string("0.785", "Dip Gamma Seçimi (PI)", options=["0.785", "1.571", "2.356", "3.142", "3.927", "4.712", "5.498", "6.283", "7.069", "7.854", "8.639", "9.425", "10.210", "10.996", "11.781", "12.566", "13.352", "14.137", "14.923", "15.708", "16.493", "17.279", "18.064", "18.849", "19.635", "20.420", "21.206", "21.991", "22.777", "23.562", "24.347", "25.133", "25.918", "26.704", "27.489", "28.274", "29.060", "29.845", "30.631", "31.416"], group=GRP_FILT_V)
v_mult_mode    = input.string("Çarpan 1", "Dip ATR Çarpan Seçimi", options=["Çarpan 1", "Çarpan 2"], group=GRP_FILT_V)
v_mult_1       = input.float(3.69, "Dip ATR Periyot Çarpanı 1", options=[0.00369, 0.0369, 0.369, 3.69, 36.9, 369, 3693], group=GRP_FILT_V)
v_mult_2       = input.string("3.141593", "Dip ATR Periyot Çarpanı 2", options=["0.000003", "0.000031", "0.000314", "0.003142", "0.031416", "0.314159", "3.141593", "31.415927", "314.159265", "3141.592654"], group=GRP_FILT_V)

// --- GÖRSEL AYARLAR ---
show_peak      = input.bool(true, "Tepe Filtresini Göster / Show Peak Filter", group=GRP_VIS)
show_valley    = input.bool(true, "Dip Filtresini Göster / Show Valley Filter", group=GRP_VIS)
use_ha         = input.bool(false, "Heikin Ashi Hesaplaması Kullan / Use Heikin Ashi Calculation", group=GRP_VIS)
show_clusters  = input.bool(true, "Ek Katmanları Göster / Show Extra Layers", group=GRP_VIS)
peak_color     = input.color(color.red, "Tepe Rengi / Peak Color", group=GRP_VIS)
valley_color   = input.color(color.green, "Dip Rengi / Valley Color", group=GRP_VIS)
filt_width     = input.int(2, "Çizgi Kalınlığı / Line Width", minval=1, maxval=5, group=GRP_VIS)

show_table     = input.bool(true, "Bilgi Tablosunu Göster / Show Info Table", group=GRP_TAB)
table_pos      = input.string("Top Right", "Tablo Konumu / Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=GRP_TAB)

// --- YARDIMCI FONKSİYONLAR / HELPERS ---
f_get_g5_val(string s) =>
    switch s
        "0.785" => 0.7853981633974483, "1.571" => 1.5707963267948966, "2.356" => 2.356194490192345, "3.142" => 3.141592653589793, "3.927" => 3.9269908169872414, "4.712" => 4.71238898038469, "5.498" => 5.497787143782138, "6.283" => 6.283185307179586, "7.069" => 7.0685834705770345, "7.854" => 7.853981633974483, "8.639" => 8.63937979737193, "9.425" => 9.42477796076938, "10.210" => 10.210176124166829, "10.996" => 10.995574287564276, "11.781" => 11.780972450961723, "12.566" => 12.566370614359172, "13.352" => 13.351768777756622, "14.137" => 14.137166941154069, "14.923" => 14.922565104551516, "15.708" => 15.707963267948966, "16.493" => 16.493361431346415, "17.279" => 17.27875959474386, "18.064" => 18.06415775814131, "18.849" => 18.84955592153876, "19.635" => 19.634954084936208, "20.420" => 20.420352248333657, "21.206" => 21.205750411731103, "21.991" => 21.991148575128552, "22.777" => 22.776546738526, "23.562" => 23.561944901923447, "24.347" => 24.347343065320896, "25.133" => 25.132741228718345, "25.918" => 25.918139392115794, "26.704" => 26.703537555513243, "27.489" => 27.48893571891069, "28.274" => 28.274333882308138, "29.060" => 29.059732045705587, "29.845" => 29.845130209103033, "30.631" => 30.630528372500482, "31.416" => 31.41592653589793, => 0.0

f_get_mult2_val(string s) =>
    switch s
        "0.000003" => 0.00000314159265, "0.000031" => 0.0000314159265, "0.000314" => 0.000314159265, "0.003142" => 0.00314159265, "0.031416" => 0.0314159265, "0.314159" => 0.314159265, "3.141593" => 3.14159265, "31.415927" => 31.4159265, "314.159265" => 314.159265, "3141.592654" => 3141.59265, => 0.0

f_kama_atr(float src, float n) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.floor(n_eff))
    float frac = n_eff - n_i
    float v_diff = math.abs(src - nz(src[1], src))
    int length = math.max(1, n_i)
    float vol_sum = ta.sma(v_diff, length) * length
    float vol = vol_sum
    if frac > 0
        vol := vol + math.abs(nz(src[n_i], src) - nz(src[n_i+1], src)) * frac
    float val_n = n_i == 0 ? src : (frac == 0 ? nz(src[n_i], src) : nz(src[n_i], src) * (1.0 - frac) + nz(src[n_i+1], src) * frac)
    float dir = math.abs(src - val_n)
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    n < 1.0 ? kama * n : kama

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

// --- HESAPLAMA AKIŞI ---
haClose = (open + high + low + close) / 4
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

eff_h = use_ha ? haHigh : high
eff_l = use_ha ? haLow  : low
float tr = use_ha ? math.max(haHigh - haLow, math.max(math.abs(haHigh - haClose[1]), math.abs(haLow - haClose[1]))) : ta.tr(true)

int lb_input_val = lb_mode == "Global (Maksimum)" ? 4713 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 144 : auto_lookback
bool is_in_range = (lb_mode == "Global (Maksimum)") or (lb_mode == "Manuel (Tarih Seçimi)") or (timenow - time < (lb_input_val + 500) * timeframe.in_seconds() * 1000)

// Pre-calculations
p_eff_m = p_mult_mode == "Çarpan 1" ? p_mult_1 : f_get_mult2_val(p_mult_2)
v_eff_m = v_mult_mode == "Çarpan 1" ? v_mult_1 : f_get_mult2_val(v_mult_2)

f_get_sz(float m) =>
    float per = math.min(4713.0, (timeframe.in_seconds() / 60.0) * m)
    f_kama_atr(tr, nz(per, 8.1))

p_sz_main = f_get_sz(p_eff_m)
v_sz_main = f_get_sz(v_eff_m)

f_get_next_m(string mode, float cur_m, string mult2_s) =>
    float res = cur_m
    if mode == "Çarpan 1"
        res := cur_m < 0.03 ? 0.0369 : cur_m < 0.3 ? 0.369 : cur_m < 3.0 ? 3.69 : cur_m < 30.0 ? 36.9 : cur_m < 300.0 ? 369.0 : 3693.0
    else
        res := mult2_s == "0.000003" ? 0.0000314159265 : mult2_s == "0.000031" ? 0.000314159265 : mult2_s == "0.000314" ? 0.00314159265 : mult2_s == "0.003142" ? 0.0314159265 : mult2_s == "0.031416" ? 0.314159265 : mult2_s == "0.314159" ? 3.14159265 : mult2_s == "3.141593" ? 31.4159265 : mult2_s == "31.415927" ? 314.159265 : mult2_s == "314.159265" ? 3141.59265 : 3141.59265
    res

p_sz_next = f_get_sz(f_get_next_m(p_mult_mode, p_eff_m, p_mult_2))
v_sz_next = f_get_sz(f_get_next_m(v_mult_mode, v_eff_m, v_mult_2))

max_bars_back(p_sz_main, 5000), max_bars_back(p_sz_next, 5000)
max_bars_back(v_sz_main, 5000), max_bars_back(v_sz_next, 5000)
max_bars_back(high, 5000), max_bars_back(low, 5000), max_bars_back(close, 5000), max_bars_back(time, 5000)
max_bars_back(eff_h, 5000), max_bars_back(eff_l, 5000)

p_g_val = f_get_g5_val(p_gamma_opt)
v_g_val = f_get_g5_val(v_gamma_opt)

f_dyn_hb(src, len) => ta.highestbars(src, math.min(len, bar_index + 1))
f_dyn_lb(src, len) => ta.lowestbars(src, math.min(len, bar_index + 1))
hb_4990 = f_dyn_hb(eff_h, 4713), lb_4990 = f_dyn_lb(eff_l, 4713)
hb_auto = f_dyn_hb(eff_h, lb_input_val), lb_auto = f_dyn_lb(eff_l, lb_input_val)

var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p = na
var float last_f_v = na

f_get_settled_idx(bool is_peak, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, float c_src, int hb_49, int lb_49, int hb_a, int lb_a) =>
    int off = lb_mode == "Global (Maksimum)" ? (is_peak ? hb_49 : lb_49) : (is_peak ? hb_a : lb_a)
    int res_idx = na(prev_settled) or (bar_index - prev_settled > lb_val) ? bar_index + off : prev_settled
    if not na(prev_f) and not na(res_idx)
        float dist_pct = math.abs(c_src - prev_f) / prev_f * 100
        if dist_pct <= auto_prox_threshold or math.abs(c_src - prev_f) > auto_threshold * sz_val
            res_idx := bar_index + off
    res_idx

if is_in_range
    settled_p_idx := lb_mode == "Manuel (Tarih Seçimi)" ? ta.valuewhen(time <= p_time, bar_index, 0) : f_get_settled_idx(true, lb_input_val, last_f_p, p_sz_main * p_g_val, settled_p_idx, eff_h, eff_l, eff_c, hb_4990, lb_4990, hb_auto, lb_auto)
    settled_v_idx := lb_mode == "Manuel (Tarih Seçimi)" ? ta.valuewhen(time <= v_time, bar_index, 0) : f_get_settled_idx(false, lb_input_val, last_f_v, v_sz_main * v_g_val, settled_v_idx, eff_h, eff_l, eff_c, hb_4990, lb_4990, hb_auto, lb_auto)

var FiltState fs_p = FiltState.new(), var FiltState fs_v = FiltState.new()
is_p_anc = bar_index == settled_p_idx or ta.change(settled_p_idx) != 0
is_v_anc = bar_index == settled_v_idx or ta.change(settled_v_idx) != 0
last_f_p := fs_p.upd_filt(eff_h, eff_l, p_sz_main * p_g_val, eff_h[math.max(0, bar_index - nz(settled_p_idx, bar_index))], is_p_anc)
last_f_v := fs_v.upd_filt(eff_h, eff_l, v_sz_main * v_g_val, eff_l[math.max(0, bar_index - nz(settled_v_idx, bar_index))], is_v_anc)

var polyline[] p_pls = array.new<polyline>(0), var polyline[] v_pls = array.new<polyline>(0)

if barstate.islast
    for pl in p_pls
        polyline.delete(pl)
    for pl in v_pls
        polyline.delete(pl)
    array.clear(p_pls), array.clear(v_pls)

    // Drawing logic Peak
    if show_peak and not na(settled_p_idx)
        int s_idx = math.max(bar_index - 4713, settled_p_idx)
        float st = eff_h[bar_index - s_idx]

        // Peak Main
        FiltState f_m = FiltState.new()
        chart.point[] pts_m = array.new<chart.point>(0)
        float cf_m = na, float pf_m = na
        for j = s_idx to bar_index
            off = bar_index - j
            cf_m := f_m.upd_filt(eff_h[off], eff_l[off], p_sz_main[off] * p_g_val, st, j == s_idx)
            if not na(pf_m) and math.abs(pf_m - cf_m) > syminfo.mintick / 10
                array.push(pts_m, chart.point.from_index(j, pf_m))
            array.push(pts_m, chart.point.from_index(j, cf_m))
            pf_m := cf_m
        array.push(p_pls, polyline.new(pts_m, line_color=color.yellow, line_width=filt_width))

        // Peak Next
        if show_clusters
            FiltState f_e = FiltState.new()
            chart.point[] pts_e = array.new<chart.point>(0)
            float cf_e = na, float pf_e = na
            for j = s_idx to bar_index
                off = bar_index - j
                cf_e := f_e.upd_filt(eff_h[off], eff_l[off], p_sz_next[off] * p_g_val, st, j == s_idx)
                if not na(pf_e) and math.abs(pf_e - cf_e) > syminfo.mintick / 10
                    array.push(pts_e, chart.point.from_index(j, pf_e))
                array.push(pts_e, chart.point.from_index(j, cf_e))
                pf_e := cf_e
            array.push(p_pls, polyline.new(pts_e, line_color=peak_color, line_width=filt_width))

    // Drawing logic Valley
    if show_valley and not na(settled_v_idx)
        int s_idx = math.max(bar_index - 4713, settled_v_idx)
        float st = eff_l[bar_index - s_idx]

        // Valley Main
        FiltState f_m = FiltState.new()
        chart.point[] pts_m = array.new<chart.point>(0)
        float cf_m = na, float pf_m = na
        for j = s_idx to bar_index
            off = bar_index - j
            cf_m := f_m.upd_filt(eff_h[off], eff_l[off], v_sz_main[off] * v_g_val, st, j == s_idx)
            if not na(pf_m) and math.abs(pf_m - cf_m) > syminfo.mintick / 10
                array.push(pts_m, chart.point.from_index(j, pf_m))
            array.push(pts_m, chart.point.from_index(j, cf_m))
            pf_m := cf_m
        array.push(v_pls, polyline.new(pts_m, line_color=color.yellow, line_width=filt_width))

        // Valley Next
        if show_clusters
            FiltState f_e = FiltState.new()
            chart.point[] pts_e = array.new<chart.point>(0)
            float cf_e = na, float pf_e = na
            for j = s_idx to bar_index
                off = bar_index - j
                cf_e := f_e.upd_filt(eff_h[off], eff_l[off], v_sz_next[off] * v_g_val, st, j == s_idx)
                if not na(pf_e) and math.abs(pf_e - cf_e) > syminfo.mintick / 10
                    array.push(pts_e, chart.point.from_index(j, pf_e))
                array.push(pts_e, chart.point.from_index(j, cf_e))
                pf_e := cf_e
            array.push(v_pls, polyline.new(pts_e, line_color=valley_color, line_width=filt_width))

    if show_table
        pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
        info_tab = table.new(pos, 2, 8, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
        c_bg = color.new(color.gray, 80), c_txt = color.white
        table.cell(info_tab, 0, 0, "💎 Volcanic", bgcolor=color.new(color.black, 40), text_color=color.yellow)
        table.cell(info_tab, 1, 0, "", bgcolor=color.new(color.black, 40))
        table.cell(info_tab, 0, 1, "Parametre", bgcolor=c_bg, text_color=c_txt)
        table.cell(info_tab, 1, 1, "Değer", bgcolor=c_bg, text_color=c_txt)
        table.cell(info_tab, 0, 2, "Tepe Gamma", bgcolor=color.new(color.gray, 90), text_color=c_txt), table.cell(info_tab, 1, 2, "G5: " + str.tostring(p_g_val, "#.###"), bgcolor=color.new(color.gray, 90))
        table.cell(info_tab, 0, 3, "Dip Gamma", bgcolor=color.new(color.gray, 90), text_color=c_txt), table.cell(info_tab, 1, 3, "G5: " + str.tostring(v_g_val, "#.###"), bgcolor=color.new(color.gray, 90))
        table.cell(info_tab, 0, 4, "Tepe Periyot", bgcolor=color.new(color.gray, 90), text_color=c_txt), table.cell(info_tab, 1, 4, str.tostring(math.min(4713, timeframe.in_seconds()/60.0*p_eff_m), "#.###"), bgcolor=color.new(color.gray, 90))
        table.cell(info_tab, 0, 5, "Dip Periyot", bgcolor=color.new(color.gray, 90), text_color=c_txt), table.cell(info_tab, 1, 5, str.tostring(math.min(4713, timeframe.in_seconds()/60.0*v_eff_m), "#.###"), bgcolor=color.new(color.gray, 90))
        table.cell(info_tab, 0, 6, "Tepe Çarpanı", bgcolor=color.new(color.gray, 90), text_color=c_txt), table.cell(info_tab, 1, 6, p_mult_mode == "Çarpan 1" ? str.tostring(p_mult_1) : p_mult_2, bgcolor=color.new(color.gray, 90))
        table.cell(info_tab, 0, 7, "Dip Çarpanı", bgcolor=color.new(color.gray, 90), text_color=c_txt), table.cell(info_tab, 1, 7, v_mult_mode == "Çarpan 1" ? str.tostring(v_mult_1) : v_mult_2, bgcolor=color.new(color.gray, 90))

var label lp = na, var label lv = na
if barstate.islast
    if not na(settled_p_idx)
        h_off = math.max(0, math.min(4999, bar_index - settled_p_idx))
        if na(lp)
            lp := label.new(settled_p_idx, eff_h[h_off], "⚓ Tepe", color=peak_color, textcolor=color.white, style=label.style_label_down)
        else
            label.set_xy(lp, settled_p_idx, eff_h[h_off])
    if not na(settled_v_idx)
        v_off = math.max(0, math.min(4999, bar_index - settled_v_idx))
        if na(lv)
            lv := label.new(settled_v_idx, eff_l[v_off], "⚓ Dip", color=valley_color, textcolor=color.white, style=label.style_label_up)
        else
            label.set_xy(lv, settled_v_idx, eff_l[v_off])
