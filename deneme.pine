//@version=6
indicator("Volcanic Auto Peaks & Valleys v6", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- GRUPLAR / GROUPS ---
string GRP_AUTO = "⚓ Otomatik Çapa Ayarları / Auto Anchor Settings"
string GRP_FILT_P = "📏 Tepe Filtre Ayarları / Peak Filter Settings"
string GRP_FILT_V = "📏 Dip Filtre Ayarları / Valley Filter Settings"
string GRP_VIS  = "🎨 Görsel Ayarlar / Visual Settings"
string GRP_TAB  = "📊 Tablo Ayarları / Table Settings"

// --- GİRDİLER / INPUTS ---
lb_mode        = input.string("Manuel", "Tarama Modu / Lookback Mode", options=["Manuel", "Otomatik (Hassasiyet)", "Global (Maksimum)", "Manuel (Tarih Seçimi)"], group=GRP_AUTO)
lb_sens        = input.int(1, "Otomatik Hassasiyet / Auto Sensitivity", minval=1, maxval=9, group=GRP_AUTO, tooltip="Otomatik modda ne kadar geriye bakılacağını ayarlar.")
auto_lookback  = input.int(81, "Manuel Tarama Mesafesi / Manual Lookback", minval=10, maxval=4713, group=GRP_AUTO)
auto_threshold = input.float(0.1, "Sabitleme Eşiği / Settle Threshold (x sz)", group=GRP_AUTO, tooltip="Fiyat filtreden bu kadar uzaklaşırsa çapa güncellenir.")
auto_prox_threshold = input.float(0.5, "Yaklaşma Eşiği / Proximity Threshold (%)", group=GRP_AUTO, tooltip="Fiyat filtreye bu kadar yaklaşırsa çapa güncellenir.")
p_time         = input.time(timestamp("2030-01-01"), "Tepe Çapa Zamanı / Peak Anchor Time", group=GRP_AUTO, confirm=true)
v_time         = input.time(timestamp("2030-01-01"), "Dip Çapa Zamanı / Valley Anchor Time", group=GRP_AUTO, confirm=true)

// --- GAMMA GİRDİLERİ ---
p_gamma_opt_5    = input.string("0.785", "Tepe Gamma Seçimi (PI)", options=["0.785", "1.571", "2.356", "3.142", "3.927", "4.712", "5.498", "6.283", "7.069", "7.854", "8.639", "9.425", "10.210", "10.996", "11.781", "12.566", "13.352", "14.137", "14.923", "15.708", "16.493", "17.279", "18.064", "18.849", "19.635", "20.420", "21.206", "21.991", "22.777", "23.562", "24.347", "25.133", "25.918", "26.704", "27.489", "28.274", "29.060", "29.845", "30.631", "31.416"], group=GRP_FILT_P)
v_gamma_opt_5    = input.string("0.785", "Dip Gamma Seçimi (PI)", options=["0.785", "1.571", "2.356", "3.142", "3.927", "4.712", "5.498", "6.283", "7.069", "7.854", "8.639", "9.425", "10.210", "10.996", "11.781", "12.566", "13.352", "14.137", "14.923", "15.708", "16.493", "17.279", "18.064", "18.849", "19.635", "20.420", "21.206", "21.991", "22.777", "23.562", "24.347", "25.133", "25.918", "26.704", "27.489", "28.274", "29.060", "29.845", "30.631", "31.416"], group=GRP_FILT_V)

auto_atr       = input.bool(true, "Otomatik ATR Periyodu / Auto ATR Period", group=GRP_VIS)
atr_mult_mode  = input.string("Çarpan 1", "ATR Çarpan Seçimi", options=["Çarpan 1", "Çarpan 2"], group=GRP_VIS)
atr_mult_1     = input.float(3.69, "ATR Periyot Çarpanı 1", options=[0.00369, 0.0369, 0.369, 3.69, 36.9, 369, 3693], group=GRP_VIS, tooltip="Otomatik modda zaman dilimi (dakika) bu sayı ile çarpılarak ATR periyodu bulunur.")
atr_mult_2     = input.string("3.141593", "ATR Periyot Çarpanı 2", options=["0.000003", "0.000031", "0.000314", "0.003142", "0.031416", "0.314159", "3.141593", "31.415927", "314.159265", "3141.592654"], group=GRP_VIS, tooltip="PI kuvvetleri (Artan hassasiyet).")
atr_opt        = input.float(8.1, "Manuel ATR Periyodu / Manual ATR Period", minval=0.01, maxval=4713.0, step=0.1, group=GRP_VIS)

f_get_mult2_val(string s) =>
    switch s
        "0.000003"   => 0.00000314159265358979
        "0.000031"   => 0.00003141592653589793
        "0.000314"   => 0.00031415926535897932
        "0.003142"   => 0.0031415926535897932
        "0.031416"   => 0.031415926535897932
        "0.314159"   => 0.31415926535897932
        "3.141593"   => 3.1415926535897932
        "31.415927"  => 31.415926535897932
        "314.159265" => 314.15926535897932
        "3141.592654"=> 3141.5926535897932
        => 0.0

eff_atr_mult   = atr_mult_mode == "Çarpan 1" ? atr_mult_1 : f_get_mult2_val(atr_mult_2)
float atr_per_auto = (timeframe.in_seconds() / 60.0) * eff_atr_mult
float atr_per = math.min(4713.0, auto_atr ? atr_per_auto : atr_opt)

show_peak      = input.bool(true, "Tepe Filtresini Göster / Show Peak Filter", group=GRP_VIS)
show_valley    = input.bool(true, "Dip Filtresini Göster / Show Valley Filter", group=GRP_VIS)
use_ha         = input.bool(false, "Heikin Ashi Hesaplaması Kullan / Use Heikin Ashi Calculation", group=GRP_VIS)
peak_color     = input.color(color.red, "Tepe Rengi / Peak Color", group=GRP_VIS)
valley_color   = input.color(color.green, "Dip Rengi / Valley Color", group=GRP_VIS)
filt_width     = input.int(2, "Çizgi Kalınlığı / Line Width", minval=1, maxval=5, group=GRP_VIS)

show_table     = input.bool(true, "Bilgi Tablosunu Göster / Show Info Table", group=GRP_TAB)
table_pos      = input.string("Top Right", "Tablo Konumu / Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=GRP_TAB)

// --- YARDIMCI FONKSİYONLAR / HELPERS ---
f_get_g5_val(string s) =>
    switch s
        "0.785" => 0.7853981633974483
        "1.571" => 1.5707963267948966
        "2.356" => 2.356194490192345
        "3.142" => 3.141592653589793
        "3.927" => 3.9269908169872414
        "4.712" => 4.71238898038469
        "5.498" => 5.497787143782138
        "6.283" => 6.283185307179586
        "7.069" => 7.0685834705770345
        "7.854" => 7.853981633974483
        "8.639" => 8.63937979737193
        "9.425" => 9.42477796076938
        "10.210" => 10.210176124166829
        "10.996" => 10.995574287564276
        "11.781" => 11.780972450961723
        "12.566" => 12.566370614359172
        "13.352" => 13.351768777756622
        "14.137" => 14.137166941154069
        "14.923" => 14.922565104551516
        "15.708" => 15.707963267948966
        "16.493" => 16.493361431346415
        "17.279" => 17.27875959474386
        "18.064" => 18.06415775814131
        "18.849" => 18.84955592153876
        "19.635" => 19.634954084936208
        "20.420" => 20.420352248333657
        "21.206" => 21.205750411731103
        "21.991" => 21.991148575128552
        "22.777" => 22.776546738526
        "23.562" => 23.561944901923447
        "24.347" => 24.347343065320896
        "25.133" => 25.132741228718345
        "25.918" => 25.918139392115794
        "26.704" => 26.703537555513243
        "27.489" => 27.48893571891069
        "28.274" => 28.274333882308138
        "29.060" => 29.059732045705587
        "29.845" => 29.845130209103033
        "30.631" => 30.630528372500482
        "31.416" => 31.41592653589793
        => 0.0


f_kama_atr(float src, float n) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.floor(n_eff))
    float frac = n_eff - n_i
    
    // Volatility calculation without a loop
    // Note: ta.sma must be called on every bar to maintain buffers
    float v_diff = math.abs(src - nz(src[1], src))
    int length = math.max(1, n_i)
    float vol_sum = ta.sma(v_diff, length) * length
    
    float vol = vol_sum
    if frac > 0
        vol := vol + math.abs(nz(src[n_i], src) - nz(src[n_i+1], src)) * frac
    
    // Direction calculation with interpolation
    float val_n = n_i == 0 ? src : (frac == 0 ? nz(src[n_i], src) : nz(src[n_i], src) * (1.0 - frac) + nz(src[n_i+1], src) * frac)
    float dir = math.abs(src - val_n)
    
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    
    // Adaptive smoothing limits to allow "faster" response for small n
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    
    // For periods below 1, scale the resulting value to represent fractional range
    n < 1.0 ? kama * n : kama

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

// --- HESAPLAMA AKIŞI / CALCULATION FLOW ---
// Heikin Ashi Calculation
var float haOpen = na
haClose = (open + high + low + close) / 4
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

eff_h  = use_ha ? haHigh : high
eff_l  = use_ha ? haLow  : low
eff_c  = use_ha ? haClose : close
float tr = use_ha ? math.max(haHigh - haLow, math.max(math.abs(haHigh - haClose[1]), math.abs(haLow - haClose[1]))) : ta.tr(true)

int lb_input_val = lb_mode == "Global (Maksimum)" ? 4713 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 144 : auto_lookback

// Calculation of is_in_range without last_bar_index dependency
// Using timenow to estimate the current bar position relative to history
bool is_in_range = (lb_mode == "Global (Maksimum)") or 
                  (lb_mode == "Manuel (Tarih Seçimi)") or
                  (timenow - time < (lb_input_val + 500) * timeframe.in_seconds() * 1000)

float rng_per   = atr_per
float cur_sz_unit_raw = f_kama_atr(tr, nz(rng_per, 8.1))
float cur_sz_unit = is_in_range ? cur_sz_unit_raw : 0.0

max_bars_back(cur_sz_unit, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)
max_bars_back(eff_h, 5000)
max_bars_back(eff_l, 5000)
max_bars_back(eff_c, 5000)

// 2. Manual Gamma Selections
float p_gamma_val_manual = f_get_g5_val(p_gamma_opt_5)
float v_gamma_val_manual = f_get_g5_val(v_gamma_opt_5)

// 3. Anchor & Lookback State
int lb_input = lb_input_val
int eff_lb = math.min(math.max(1, lb_input), bar_index + 1)

// Optimization: Dynamic lookback calls to handle short history (e.g., Monthly timeframe)
f_dyn_hb(src, len) => ta.highestbars(src, math.min(len, bar_index + 1))
f_dyn_lb(src, len) => ta.lowestbars(src, math.min(len, bar_index + 1))

hb_4990 = f_dyn_hb(eff_h, 4713), lb_4990 = f_dyn_lb(eff_l, 4713)
hb_auto = f_dyn_hb(eff_h, lb_input), lb_auto = f_dyn_lb(eff_l, lb_input)

// Local extremes
int hb_raw = lb_mode == "Global (Maksimum)" ? hb_4990 : hb_auto
int lb_raw = lb_mode == "Global (Maksimum)" ? lb_4990 : lb_auto

// Persistent Gammas
var float p_g_main = na
var float v_g_main = na

if barstate.islast
    p_g_main := p_gamma_val_manual
    v_g_main := v_gamma_val_manual

// 5. Final Effective Gammas & Sizes
float p_gamma_val = p_gamma_val_manual
float v_gamma_val = v_gamma_val_manual
float cur_p_sz = cur_sz_unit * p_gamma_val
float cur_v_sz = cur_sz_unit * v_gamma_val

// 6. Anchor Settling & History
var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p = na
var float last_f_v = na

f_get_settled_idx(bool is_peak, int lb_mode_idx, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, float c_src, int hb_49, int lb_49, int hb_a, int lb_a) =>
    int off = lb_mode_idx == 0 ? (is_peak ? hb_49 : lb_49) : (is_peak ? hb_a : lb_a)
    int raw_ext_idx = bar_index + off
    int res_idx = prev_settled
    if na(prev_settled) or (bar_index - prev_settled > lb_val)
        res_idx := raw_ext_idx
    else
        float dist_pct = not na(prev_f) ? math.abs(c_src - prev_f) / prev_f * 100 : na
        bool prox_reset = not na(dist_pct) and dist_pct <= auto_prox_threshold
        bool threshold_reset = not na(prev_f) and not na(sz_val) and math.abs(c_src - prev_f) > auto_threshold * sz_val
        if prox_reset or threshold_reset
            res_idx := raw_ext_idx
    res_idx

int lb_mode_idx = lb_mode == "Global (Maksimum)" ? 0 : 1
if is_in_range
    settled_p_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(true, lb_mode_idx, lb_input, last_f_p, cur_p_sz, settled_p_idx, eff_h, eff_l, eff_c, hb_4990, lb_4990, hb_auto, lb_auto)
    settled_v_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(false, lb_mode_idx, lb_input, last_f_v, cur_v_sz, settled_v_idx, eff_h, eff_l, eff_c, hb_4990, lb_4990, hb_auto, lb_auto)

if lb_mode == "Manuel (Tarih Seçimi)"
    settled_p_idx := ta.valuewhen(time <= p_time, bar_index, 0)
    settled_v_idx := ta.valuewhen(time <= v_time, bar_index, 0)

// 7. Filter States
var FiltState fs_p = FiltState.new()
var FiltState fs_v = FiltState.new()

is_p_anc = (bar_index == settled_p_idx) or (ta.change(settled_p_idx) != 0)
is_v_anc = (bar_index == settled_v_idx) or (ta.change(settled_v_idx) != 0)
float init_p_val = eff_h[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
float init_v_val = eff_l[math.max(0, bar_index - nz(settled_v_idx, bar_index))]

is_new_hi = eff_h == ta.highest(eff_h, eff_lb)
is_new_lo = eff_l == ta.lowest(eff_l, eff_lb)

last_f_p := fs_p.upd_filt(eff_h, eff_l, cur_p_sz, init_p_val, is_p_anc)
last_f_v := fs_v.upd_filt(eff_h, eff_l, cur_v_sz, init_v_val, is_v_anc)

// Visualization
var polyline[] p_pl = array.new<polyline>(0)
var polyline[] v_pl = array.new<polyline>(0)

if barstate.islast
    for pl in p_pl
        polyline.delete(pl)
    for pl in v_pl
        polyline.delete(pl)
    array.clear(p_pl), array.clear(v_pl)
    
    int p_idx_u = settled_p_idx
    int v_idx_u = settled_v_idx


    if show_peak and not na(p_idx_u)
        color dr_color = color.yellow

        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4713, p_idx_u)
        float st = eff_h[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h[off], eff_l[off], cur_sz_unit[off] * p_g_main, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(p_pl, polyline.new(pts, line_color=dr_color, line_width=filt_width))

    if show_valley and not na(v_idx_u)
        color dr_color = color.yellow

        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4713, v_idx_u)
        float st = eff_l[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h[off], eff_l[off], cur_sz_unit[off] * v_g_main, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(v_pl, polyline.new(pts, line_color=dr_color, line_width=filt_width))

// Table
if show_table and barstate.islast
    pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    var table info_tab = table.new(pos, 2, 6, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    c_bg = color.new(color.gray, 80), c_txt = color.white
    table.cell(info_tab, 0, 0, "💎 Volcanic", bgcolor=color.new(color.black, 40), text_color=color.yellow)
    table.cell(info_tab, 1, 0, "", bgcolor=color.new(color.black, 40))
    table.cell(info_tab, 0, 1, "Parametre", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 1, 1, "Değer", bgcolor=c_bg, text_color=c_txt)
    
    table.cell(info_tab, 0, 2, "Ana Tepe Filtresi", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 2, "G5: " + str.tostring(p_g_main, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
    
    table.cell(info_tab, 0, 3, "Ana Dip Filtresi", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 3, "G5: " + str.tostring(v_g_main, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
    
    table.cell(info_tab, 0, 4, "ATR Period", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 4, str.tostring(atr_per, "#.###") + (auto_atr ? " (Oto)" : ""), bgcolor=color.new(color.gray, 90), text_color=c_txt)
    
    table.cell(info_tab, 0, 5, "ATR Çarpanı", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 5, atr_mult_mode == "Çarpan 1" ? str.tostring(atr_mult_1) : atr_mult_2, bgcolor=color.new(color.gray, 90), text_color=c_txt)

var label lp = na
var label lv = na
var line llin_p = na
var line llin_v = na

if barstate.islast
    int p_idx_label = settled_p_idx
    int v_idx_label = settled_v_idx

    if not na(p_idx_label)
        int h_off = math.max(0, math.min(4999, bar_index - p_idx_label))
        if na(lp)
            lp := label.new(p_idx_label, eff_h[h_off], "⚓ Tepe", color=peak_color, textcolor=color.white, style=label.style_label_down)
            if lb_mode == "Manuel (Tarih Seçimi)"
                llin_p := line.new(p_idx_label, eff_l[h_off], p_idx_label, eff_h[h_off], extend=extend.both, color=color.new(peak_color, 50), style=line.style_dashed)
        else
            label.set_xy(lp, p_idx_label, eff_h[h_off])
            if not na(llin_p)
                line.set_xy1(llin_p, p_idx_label, eff_l[h_off])
                line.set_xy2(llin_p, p_idx_label, eff_h[h_off])

    if not na(v_idx_label)
        int v_off = math.max(0, math.min(4999, bar_index - v_idx_label))
        if na(lv)
            lv := label.new(v_idx_label, eff_l[v_off], "⚓ Dip", color=valley_color, textcolor=color.white, style=label.style_label_up)
            if lb_mode == "Manuel (Tarih Seçimi)"
                llin_v := line.new(v_idx_label, eff_l[v_off], v_idx_label, eff_h[v_off], extend=extend.both, color=color.new(valley_color, 50), style=line.style_dashed)
        else
            label.set_xy(lv, v_idx_label, eff_l[v_off])
            if not na(llin_v)
                line.set_xy1(llin_v, v_idx_label, eff_l[v_off])
                line.set_xy2(llin_v, v_idx_label, eff_h[v_off])


